# Public OAuth client identifier (not a client secret). Leave empty to disable the connection.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Canonical external origin, no trailing slash. Required in hosted production behind a proxy.
APP_ORIGIN=http://localhost:3000
# Persistent single-instance storage. Mount this directory on a durable volume.
HAVRUTA_DB_PATH=./data/havruta.sqlite
